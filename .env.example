# Copy to .env (never commit .env) or set as OS / hosting environment variables.
# All values below are placeholders.

# ---- Database (MySQL 8) ----
DB_URL=jdbc:mysql://localhost:3306/tshirt_shop?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=tshirt_app
DB_PASSWORD=change-me

# Integration tests (mvnw verify). Optional: defaults to tshirt_shop_test with the DB_* user.
# TEST_DB_URL=jdbc:mysql://localhost:3306/tshirt_shop_test?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# TEST_DB_USERNAME=tshirt_app
# TEST_DB_PASSWORD=change-me

# ---- JWT ----
# Base64 HMAC key, at least 32 bytes decoded (the app refuses to start otherwise).
# Generate: openssl rand -base64 64
JWT_SECRET=change-me
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
# Refresh-token cookie Secure flag. Browsers allow Secure cookies on http://localhost.
REFRESH_COOKIE_SECURE=true

# ---- Razorpay (use rzp_test_ keys during development) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me
RAZORPAY_WEBHOOK_SECRET=change-me

# ---- Image storage: local | cloudinary ----
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
CLOUDINARY_URL=

# ---- Mail (order confirmations, password reset) ----
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=orders@example.com

# ---- App ----
APP_FRONTEND_URL=http://localhost:4200
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
STOCK_RESERVATION_MINUTES=15

# ---- First admin account (created on first start if no admin exists) ----
# Password: at least 12 characters with a letter and a digit.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ---- Business details for invoices (optional; empty values are not printed) ----
BUSINESS_NAME=T-Shirt Shop
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
BUSINESS_GSTIN=
BUSINESS_EMAIL=
BUSINESS_PHONE=

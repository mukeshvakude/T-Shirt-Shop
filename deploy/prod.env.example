# Production settings for /etc/tshirt-shop/prod.env (owner root, chmod 600). Never commit the real file.
# Every value below is a placeholder. The app refuses to start in prod with http:// or localhost
# addresses, a non-Secure refresh cookie or missing Razorpay keys, and warns about the rest.

DB_URL=jdbc:mysql://127.0.0.1:3306/tshirt_shop?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=tshirt_app
DB_PASSWORD=change-me
DB_POOL_SIZE=20

# openssl rand -base64 64 | tr -d '\n'   (must be one line)
JWT_SECRET=change-me
REFRESH_COOKIE_SECURE=true

# Live keys after KYC: Razorpay Dashboard > Live Mode > Account & Settings > API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me
RAZORPAY_WEBHOOK_SECRET=change-me

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=/var/lib/tshirt-shop/uploads

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=orders@example.com

# ---- WhatsApp (optional, see docs/WHATSAPP.md) ----
# Shop number for the "WhatsApp us" button, e.g. +91 98765 43210. Empty hides the button.
WHATSAPP_CHAT_NUMBER=
# Gets a WhatsApp alert for every new order (needs the Cloud API below).
WHATSAPP_OWNER_NUMBER=
# Meta WhatsApp Cloud API: automatic order updates. Empty = nothing is sent automatically.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en

APP_FRONTEND_URL=https://shop.example.in
APP_CORS_ALLOWED_ORIGINS=https://shop.example.in
STOCK_RESERVATION_MINUTES=15

# First admin, created on the first start only. Remove the password from this file afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

BUSINESS_NAME=T-Shirt Shop
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
BUSINESS_GSTIN=
BUSINESS_EMAIL=
BUSINESS_PHONE=
